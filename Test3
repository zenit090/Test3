    noBobberFallback = 3,    -- không thấy bobber sau số giây này -> coi như đã chạm nước
    landTimeout = 6,         -- sau khi chạm nước, chờ nút shake tối đa
    waitTimeout = 20,        -- sau shake, chờ reel tối đa
    settleSpeed = 2, settleTime = 0.25,
    shakeEndGrace = 1.5, reelEndGrace = 0.7,
    reelRemoteAfter = 3,     -- reel quá số giây này mà chưa xong -> gửi remote reelfinished
