    "Above The Clouds", "Everturn Forest", "The Arch", "Birch Cay", "Keepers Altar" }

local function addZone(name, v, src) Zones[name] = v; ZoneSrc[name] = src end

for _, z in ipairs(BUILTIN) do addZone(z[1], Vector3.new(z[2], z[3], z[4]), z[5]) end

local function slug(n)
    local s = n:gsub(" ", "_")
    s = s:gsub("'", "%%27")
    return s
end

local function fetchWiki()
    local okH, hg = pcall(function() return game.HttpGet end)
    if not okH or not hg then return 0 end
    local n = 0
    for _, name in ipairs(WIKI_PAGES) do
        local ok, html = pcall(function() return game:HttpGet("https://fischipedia.org/wiki/" .. slug(name)) end)
        if ok and type(html) == "string" then
            local x, y, z = html:match("located at%s*(%-?%d+),%s*(%-?%d+),%s*(%-?%d+)")
            if x then addZone(name, Vector3.new(tonumber(x), tonumber(y), tonumber(z)), "wiki-live"); n = n + 1 end
        end
        task.wait(0.1)
    end
    return n
end

local function scanGameSpots()
    local node = workspace
    for _, nm in ipairs({ "world", "spawns", "TpSpots" }) do node = node and node:FindFirstChild(nm) end
    if not node then return 0 end
    local n = 0
    for _, p in ipairs(node:GetChildren()) do
        if p:IsA("BasePart") then addZone(p.Name, p.Position, "game"); n = n + 1
        elseif p:IsA("Model") then addZone(p.Name, p:GetPivot().Position, "game"); n = n + 1 end
    end
    return n
end

local function zoneNames()
    local t = {}
    for n in pairs(Zones) do t[#t + 1] = n end
    table.sort(t)
    return t
end

local function teleportTo(name)
    local pos, root = Zones[name], hrp()
    if not (pos and root) then return false end
    -- tải map quanh điểm đến trước (StreamingEnabled) để khỏi rơi xuyên đất
    pcall(function() lp:RequestStreamAroundAsync(pos) end)
    root = hrp()
    if not root then return false end
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = CFrame.new(pos + Vector3.new(0, 6, 0))
    return true
end

