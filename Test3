local WIKI_PAGES = { "Moosewood", "Roslit Bay", "Snowcap Island", "Sunstone Island", "Terrapin Island",
    "Mushgrove Swamp", "Ancient Isle", "Forsaken Shores", "Desolate Deep", "Grand Reef", "Castaway Cliffs",
