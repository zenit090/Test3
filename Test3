local function mk(class, props, par)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = par
    return o
end
local BG, FG, ACC, WHITE = Color3.fromRGB(28, 28, 34), Color3.fromRGB(45, 45, 54), Color3.fromRGB(70, 130, 255), Color3.new(1, 1, 1)

local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function isMove(i) return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end

-- kéo thả (chuột + cảm ứng); onTap chạy khi chạm mà không kéo
local function makeDraggable(frame, handle, onTap)
    local dragging, moved, startIn, startPos = false, false, nil, nil
    handle.InputBegan:Connect(function(i)
        if isPress(i) then
            dragging, moved, startIn, startPos = true, false, i.Position, frame.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if not moved and onTap then onTap() end
                end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and isMove(i) then
            local d = i.Position - startIn
            if d.Magnitude > 6 then moved = true end
            if moved then
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                           startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end)
end

