---------------------------------------------------------------- HELPERS
local function char() return lp.Character end
local function hum()  local c = char(); return c and c:FindFirstChildOfClass("Humanoid") end
local function hrp()  local c = char(); return c and c:FindFirstChild("HumanoidRootPart") end

local function isRod(t)
    return t:IsA("Tool") and (t:FindFirstChild("events") ~= nil or t.Name:lower():find("rod") ~= nil)
end

local function getHeldRod()
    local c = char()
    if c then for _, t in ipairs(c:GetChildren()) do if isRod(t) then return t end end end
end

-- trả về (rod, đã cầm sẵn?)
local function findRod()
    local held = getHeldRod()
    if held then return held, true end
    local bp, h = lp:FindFirstChild("Backpack"), hum()
    if bp and h then
        for _, t in ipairs(bp:GetChildren()) do
            if isRod(t) then h:EquipTool(t) return t, false end
        end
    end
end

local function findCastRemote(rod)
    local ev = rod:FindFirstChild("events")
    local r = ev and ev:FindFirstChild("cast")
    if r and r:IsA("RemoteEvent") then return r end
    for _, d in ipairs(rod:GetDescendants()) do
        if d:IsA("RemoteEvent") and d.Name:lower():find("cast") then return d end
    end
end

local function mouseCast()
    local vp = workspace.CurrentCamera.ViewportSize
    local x, y = vp.X / 2, vp.Y / 2
    VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.6)
    VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function doCast(rod)
    local r = findCastRemote(rod)
    if r and not State.mouseCast then
        r:FireServer(CONFIG.castPower, 1)
        return "remote"
    end
    mouseCast()
    return "mouse"
end

-- Tìm GUI theo từ khóa trong tên (không phụ thuộc tên chính xác)
local function findGui(key)
    for _, g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and g.Name:lower():find(key) then return g end
    end
end

local function getShakeButton()
    local ui = findGui("shake")
    if not ui then return end
    local sz = ui:FindFirstChild("safezone")
    local b = sz and sz:FindFirstChild("button")
    if b and b:IsA("GuiButton") and b.Visible then return b end
    for _, d in ipairs(ui:GetDescendants()) do
        if d:IsA("GuiButton") and d.Visible then return d end
    end
end

local function getReelBar()
    local ui = findGui("reel")
    return ui and ui:FindFirstChild("playerbar", true)
end

local function clickButton(btn)
    pcall(function() if firesignal then firesignal(btn.MouseButton1Click) end end)
    pcall(function()
        GuiService.SelectedObject = btn
        VIM:SendKeyEvent(true,  Enum.KeyCode.Return, false, game)
        VIM:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
    end)
end

local function getBobber()
    local c = char()
    if not c then return end
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then
            local b = t:FindFirstChild("bobber", true)
            if b and b:IsA("BasePart") then return b end
        end
    end
end

local settleSince = nil
local function bobberOnWater(b, now)
    local inWater = false
    pcall(function()
        local t = workspace.Terrain
        local cell = t:WorldToCell(b.Position)
        local center = t:CellCenterToWorld(cell.X, cell.Y, cell.Z)
        local half = Vector3.new(2, 2, 2)
        local mats, occ = t:ReadVoxels(Region3.new(center - half, center + half), 4)
        inWater = mats[1][1][1] == Enum.Material.Water and occ[1][1][1] > 0
    end)
    if inWater then return true end
    if b.AssemblyLinearVelocity.Magnitude < CONFIG.settleSpeed then
        settleSince = settleSince or now
        return now - settleSince >= CONFIG.settleTime
    end
    settleSince = nil
    return false
end

---------------------------------------------------------------- STATE MACHINE (cast/shake/reel loại trừ nhau)
--   idle -> cast -> splash -> shake -> wait -> reel -> idle
local Phase, phaseSince = "idle", tick()
local lastSeen = { shake = 0, reel = 0 }
local casting, reelStart, reelRemoteFired = false, nil, false
local phaseLabel, dbgLabel, dbgNote = nil, nil, ""

local function setPhase(p) Phase, phaseSince = p, tick() end

task.spawn(function()
    local dbgTick = 0
    while true do
        task.wait(0.05)
        local now = tick()
        local shakeBtn, reelBar = getShakeButton(), getReelBar()
        if shakeBtn then lastSeen.shake = now end
        if reelBar  then lastSeen.reel  = now end

        -- 1) chuyển trạng thái
        if Phase == "reel" then
            if not reelBar and now - lastSeen.reel > CONFIG.reelEndGrace then setPhase("idle") end
        elseif Phase == "shake" then
            if not shakeBtn and now - lastSeen.shake > CONFIG.shakeEndGrace then setPhase("wait") end
        else
            if reelBar then setPhase("reel")
            elseif shakeBtn then setPhase("shake")
            elseif Phase == "cast" then
                local b = getBobber()
                if b and now - phaseSince > 0.5 and bobberOnWater(b, now) then
                    setPhase("splash")
                elseif not b and now - phaseSince > CONFIG.noBobberFallback then
                    setPhase("splash")
                elseif now - phaseSince > CONFIG.castTimeout then
                    setPhase("idle")
                end
            elseif Phase == "splash" and now - phaseSince > CONFIG.landTimeout then setPhase("idle")
            elseif Phase == "wait" and now - phaseSince > CONFIG.waitTimeout then setPhase("idle")
            end
        end

        -- 2) hành động (mỗi chức năng chỉ chạy đúng trạng thái)
        if Phase == "idle" and State.cast and not casting and now - lastCast >= CONFIG.castDelay then
            casting = true
            task.spawn(function()
                local ok, err = pcall(function()
                    local rod, equipped = findRod()
                    if not rod then dbgNote = "Không thấy cần câu" lastCast = tick() return end
                    if not equipped then task.wait(0.8) end
                    local how = doCast(rod)
                    dbgNote = "Cast bằng " .. how
                    lastCast = tick(); settleSince = nil
                    if Phase == "idle" then setPhase("cast") end
                end)
                if not ok then dbgNote = "Lỗi cast: " .. tostring(err); lastCast = tick() end
                casting = false
            end)
        elseif Phase == "shake" and State.shake and shakeBtn then
            clickButton(shakeBtn)
        end

        if Phase == "reel" then
            reelStart = reelStart or now
            if State.reel and not reelRemoteFired and now - reelStart > CONFIG.reelRemoteAfter then
                reelRemoteFired = true
                pcall(function() RS.events.reelfinished:FireServer(100, true) end)
            end
        else
            reelStart, reelRemoteFired = nil, false
        end

        -- 3) nhãn trạng thái / debug
        if phaseLabel then phaseLabel.Text = "Trạng thái: " .. Phase end
        if dbgLabel and now - dbgTick > 0.5 then
            dbgTick = now
            local rod = getHeldRod()
            dbgLabel.Text = string.format("Cần: %s | remote cast: %s | shake UI: %s | reel UI: %s\n%s",
                rod and rod.Name or "chưa cầm", (rod and findCastRemote(rod)) and "có" or "không",
                findGui("shake") and "có" or "không", findGui("reel") and "có" or "không", dbgNote)
        end
    end
end)

-- Auto Reel: chỉ khi Phase == "reel", đặt thanh control về "1"
RunService.RenderStepped:Connect(function()
    if Phase ~= "reel" or not State.reel then return end
    pcall(function()
        local bar = getReelBar()
        if bar then bar.Size = UDim2.new(1, 0, bar.Size.Y.Scale, bar.Size.Y.Offset) end
    end)
end)

---------------------------------------------------------------- PLAYER: SPEED / INF JUMP / NOCLIP
RunService.Heartbeat:Connect(function()
    if State.speed then
        local h = hum()
        if h then h.WalkSpeed = math.clamp(speedValue, CONFIG.minSpeed, CONFIG.maxSpeed) end
    end
end)

UIS.JumpRequest:Connect(function()
    if State.infJump then
        local h = hum()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

local noclipOrig = setmetatable({}, { __mode = "k" })
RunService.Stepped:Connect(function()
    if not State.noclip then return end
    local c = char()
    if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then
            noclipOrig[p] = true
            p.CanCollide = false
        end
    end
end)
local function restoreCollide()
    for p in pairs(noclipOrig) do if p.Parent then p.CanCollide = true end end
    table.clear(noclipOrig)
end

